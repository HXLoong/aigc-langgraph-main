# ============================================================
# otc-agent · 客户现场私有化部署 .env 模板
#
# 部署前由客户 IT 填实际值，复制到 .env：
#   cp .env.customer.template .env
#   nano .env  # 替换所有 <FILL_*> 占位符
#   chmod 600 .env  # 限制读权限
#
# 安全约束：
#   - 标记 # SECRET 的字段绝不能 commit 到 git
#   - .env 已在 .gitignore，但仍需 chmod 600
#   - API key / password 推荐放客户内网 1Password / Vault，
#     部署时临时写入 .env，部署完成后删除明文备份
#
# 模型接口沿用历史配置字段名：
#   - QWEN_* 通用前缀（开发期=Qwen，现场=DeepSeek-v4-pro）
#   - 应用通过 base_url + api_key 切换具体 vendor
# ============================================================

# ============================================================
# § 1 · 环境标识
# ============================================================

# 运行环境标识，影响日志级别与一些守卫开关
# 必填，可选值：development / staging / production
ENVIRONMENT=production

# 日志级别，可选 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式：json（推荐，每条带 trace_id / conversation_id / message_id）/ console / auto
LOG_FORMAT=json

# ============================================================
# § 2 · MySQL 数据库（与 Java 共库）
# ============================================================
# 两条 URI 填写同一 Java 数据库的实际连接；不新建独立 checkpoint/业务库。
# 格式均为 mysql+aiomysql://user:password@host:port/database。
# 本地示例目标 localhost:3308/otc_goats_ai_trading_dev；现场填写 Java 实际库。
# 容器连接宿主机使用 host.docker.internal；密码中的特殊字符使用 URL 编码。
# 表前缀 langgraph_；字符集 utf8mb4；排序规则 utf8mb4_general_ci。
# 初始化前在连接参数中选中库，再执行 sql/init.sql；脚本不建库、不包含 USE 或授权。
# 应用启动仅校验结构与版本；MySQL 版本要求 8.0.19 ≤ v < 9.6.0。
# SECRET（含密码，不可 commit）
CHECKPOINT_MYSQL_URI=<FILL_CHECKPOINT_MYSQL_URI>
BUSINESS_MYSQL_URI=<FILL_BUSINESS_MYSQL_URI>

# 连接池：两个连接用途共用 Java 数据库，表名固定使用 langgraph_ 前缀。
CHECKPOINT_POOL_MINSIZE=1
CHECKPOINT_POOL_MAXSIZE=10
CHECKPOINT_POOL_RECYCLE_SECONDS=1800
# 多轮会话与请求幂等；启动前在目标库执行 sql/init.sql。
# 纯单元测试可通过命令级环境变量将以下两个开关设置为 false。
USE_MYSQL_CHECKPOINTER=true
REQUEST_IDEMPOTENCY=true
HISTORY_WINDOW_MESSAGES=40

# ============================================================
# § 3 · 大模型 API（DeepSeek-v4-pro / ADR 0018）
# ============================================================

# 大模型 API endpoint，OpenAI 兼容接口
# 现场使用 DeepSeek-v4-pro（默认 https://api.deepseek.com/v1）
# 开发期使用 Qwen（默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
QWEN_API_BASE=<FILL_LLM_API_BASE>

# 大模型 API Key
# SECRET（不可 commit）
# 来源：客户开通 DeepSeek 账号后获取（C1.9 调研 §6）
QWEN_API_KEY=<FILL_LLM_API_KEY>

# 标准模型（短文本路由、意图识别、structured output 全部用此）
# 现场默认 deepseek-v4-pro
# 开发期默认 qwen3-30b-a3b
QWEN_MODEL_STANDARD=<FILL_LLM_MODEL_STANDARD>

# 意图/推理接口模型（工厂名为历史兼容，当前统一关闭思考）
# 现场可与 STANDARD 共用 deepseek-v4-pro
# 可与标准模型共用同一兼容模型。
QWEN_MODEL_THINKING=<FILL_LLM_MODEL_THINKING>

# 复杂字段提取模型：必须与所选网关匹配并支持结构化输出。
QWEN_MODEL_COMPLEX=<FILL_LLM_MODEL_COMPLEX>

# 视觉模型：配置同一网关中支持图片输入的模型；不使用图片时可留空。
QWEN_MODEL_VL=<FILL_VISION_MODEL_OR_LEAVE_EMPTY>

# Anthropic Claude API Key（可选，shadow compare 用）
# SECRET（不可 commit）
# ANTHROPIC_API_KEY=<FILL_ANTHROPIC_API_KEY>

# ============================================================
# § 4 · 后端业务 API（Java 业务系统）
# ============================================================

# Java 后端基础 URL：主机与端口，不含 /admin-api；客户端自动追加路径。
# 必填，无默认值
OTC_API_BASE_URL=<FILL_OTC_API_BASE_URL>

# Java 后端 @PlatformApiAuth Token
# SECRET（不可 commit）
# 客户 IT 提供，参考 C1.9 调研 §5
OTC_API_SECRET=<FILL_OTC_API_SECRET>

# === 调用预算与只读重试 ===
# 所有步骤共用工作流总预算，并预留收尾时间；后端实际等待受剩余预算限制。
LLM_TIMEOUT_SECONDS=20
BACKEND_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=60
RESPONSE_RESERVE_SECONDS=5
PERSIST_TIMEOUT_SECONDS=5
MULTIMODAL_FETCH_TIMEOUT_SECONDS=5
GOATS_AGENT_RFQ_TIMEOUT_SECONDS=5
GOATS_AGENT_INSTRUCTION_TIMEOUT_SECONDS=5
GOATS_RFQ_DIRECT_TIMEOUT_SECONDS=5
# 只读节点最多尝试两次；业务写入不自动重试。
NODE_RETRY_MAX_ATTEMPTS=2
NODE_RETRY_INITIAL_INTERVAL_SECONDS=0.5

# ============================================================
# § 5 · GOATS 标的查询服务
# ============================================================

# GOATS 服务基础 URL
GOATS_BASE_URL=<FILL_GOATS_BASE_URL>

# GOATS 客户端凭证
# SECRET（不可 commit）
GOATS_CLIENT_ID=<FILL_GOATS_CLIENT_ID>
GOATS_CLIENT_SECRET=<FILL_GOATS_CLIENT_SECRET>
GOATS_EXTAPP_SALT=<FILL_GOATS_EXTAPP_SALT>

# 快速询价所需的 GOATS Agent 标识。
GOATS_OPT_AGENT_ID=<FILL_GOATS_OPT_AGENT_ID>
GOATS_OPT_AGENT_SUB_ID=<FILL_GOATS_OPT_AGENT_SUB_ID_OR_LEAVE_EMPTY>

# ============================================================
# § 6 · 标的查询接口（securities-instrument，ADR 0012）
# ============================================================

# 通常 = OTC_API_BASE_URL + /admin-api/integration/securities-instrument/select
SECURITIES_INSTRUMENT_URL=<FILL_SECURITIES_INSTRUMENT_URL>

# SECRET（不可 commit）
SECURITIES_INSTRUMENT_KEY=<FILL_SECURITIES_INSTRUMENT_KEY>

# ============================================================
# § 7 · 标的池 MySQL（直连查询，可选）
# ============================================================

# 辅助脚本预留配置；当前主链路经 Java/GOATS 接口校验标的。
# 若不使用，留空白即可
TICKER_MYSQL_HOST=<FILL_TICKER_MYSQL_HOST_OR_LEAVE_EMPTY>
TICKER_MYSQL_PORT=3306
TICKER_MYSQL_USER=<FILL_TICKER_MYSQL_USER>
# SECRET（不可 commit）
TICKER_MYSQL_PASSWORD=<FILL_TICKER_MYSQL_PASSWORD>
TICKER_MYSQL_DB=<FILL_TICKER_MYSQL_DB>

# ============================================================
# § 8 · 外部搜索（可选，业务不依赖）
# ============================================================

# SECRET（不可 commit）
BOCHA_API_KEY=<FILL_BOCHA_API_KEY_OR_LEAVE_EMPTY>
TAVILY_API_KEY=<FILL_TAVILY_API_KEY_OR_LEAVE_EMPTY>

# ============================================================
# § 9 · LangFuse 监控（self-hosted，C1.11 部署）
# ============================================================

# 是否启用 LangFuse trace 上报
ENABLE_LANGFUSE=true

# LangFuse self-hosted 部署地址
# 客户内网域名（HTTPS 反代）或 IP:Port
LANGFUSE_BASE_URL=<FILL_LANGFUSE_BASE_URL>
LANGFUSE_HOST=<FILL_LANGFUSE_HOST>

# LANGFUSE_HOST 与 LANGFUSE_BASE_URL 应填写相同部署地址。
# LangFuse 项目 API Key（C1.11 §3.3 步骤生成）
# SECRET（不可 commit）
LANGFUSE_PUBLIC_KEY=<FILL_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<FILL_LANGFUSE_SECRET_KEY>

# LangFuse 项目名（在 LangFuse 控制台创建项目时填写）
LANGFUSE_PROJECT=otc-agent-prod
# 仅可信调用方可开启传入 traceparent 关联。
TRUST_INBOUND_TRACEPARENT=false

# ============================================================
# § 10 · 灰度切换（M4 金丝雀阶段使用）
# ============================================================

# LangGraph 路径配置；后端模拟由 DRY_RUN_BACKEND 独立控制。
USE_LANGGRAPH=true

# LangGraph 流量比例（0.0-1.0，金丝雀切流期使用）
# M3 阶段 1 期间保持 1.0；M4 金丝雀按群组切流，不通过该参数
LANGGRAPH_TRAFFIC_RATIO=1.0

# Shadow 双跑模式（F4.1 阶段启用）
# M3 阶段 1 期间保持 false
SHADOW_MODE=false

# 金丝雀切流白名单（G5.1 / F4.2-F4.5）
# 逗号分隔的 roomId 列表，企微管理员把这些群 Webhook 切到 LangGraph 时填入
# 服务侧不做流量分配——这里只是"白名单"，进入的非白名单 roomId 会触发 P0 告警
#
# 配置示例：
#   空（默认）              金丝雀未启用，任何 roomId 都视为非 canary
#   r-test-1,r-test-2      F4.2 第一阶段，1-2 个测试群
#   <30% 群组 ID 列表>      F4.3 第二阶段
#   ALL                    F4.4 全量上线（任何 roomId 都视为 canary）
CANARY_ROOM_IDS=

# ============================================================
# § 11 · Prompt 版本
# ============================================================

# 提示词以 app/prompts/**/*.md 为真源，灰度版本由 _versions.yaml 管理。

# 是否从 LangFuse 拉提示词（运行时热更，需先在 LangFuse 创建对应 prompt）
# 现场首次部署用 false（走本地 app/prompts/**/*.md）
USE_LANGFUSE_PROMPTS=false

# P95 延迟告警 baseline（ADR 0019 P1 触发条件之一）
# scripts/run_alerts.py 读取此值，告警阈值 = baseline × 3
# 默认 4200ms 来自 #29 M2 measurement（Qwen + mock backend）
# M3 真后端跑稳后用真实 P95 重设；本字段空 → 用代码默认 4200
M2_BASELINE_P95_MS=4200

# F4.1 Shadow 双跑模式（PR #112）
# true → 拦截 *.operate 写类客户端调用（place/cancel/confirm/modify/close），
#        返回 fake CommonResult{code:0, msg:"dry-run intercepted"}，
#        避免 LangGraph 替代客户真下单。read 类（query/get/list/search/
#        inference_prompt）正常调真后端。
# F4.1 shadow 期生效，F4.2 切流前**务必**改回 false。
# 详见 docs/m3-shadow-compare-dry-run-design.md
DRY_RUN_BACKEND=false

# ============================================================
# § 12 · 真后端联调测试隔离账号（D2.* probe + E3.* harness 用）
# ============================================================
#
# 阶段 2 D2.* 联调 + 阶段 3 E3.* harness 跑真后端时使用的隔离账号。
# 生产环境**不调**这些 endpoint 时可留空；如果用了 scripts/probe_*_e2e.py 或
# python -m harness run（非 mock 模式）必须填客户提供的测试 userId / roomId，
# 避免污染生产业务流。
#
# 来源：客户提供（与 GOATS_OPT_AGENT_ID / GOATS_COM_AGENT_ID 同一批次）
EVAL_USER_ID=<FILL_EVAL_USER_ID_OR_LEAVE_EMPTY>
EVAL_ROOM_ID=<FILL_EVAL_ROOM_ID_OR_LEAVE_EMPTY>

EVAL_GUID=<FILL_EVAL_GUID_OR_LEAVE_EMPTY>
# 本地回归准备消息时使用与 Java 一致的数据库；非本地回归可留空。
EVAL_JAVA_DATABASE=<FILL_EVAL_JAVA_DATABASE_OR_LEAVE_EMPTY>
