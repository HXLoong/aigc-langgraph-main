# === MySQL 配置 ===
# 用于 LangGraph checkpoint（会话状态）
CHECKPOINT_MYSQL_URI=mysql://otc_agent:password@localhost:3306/otc_agent_checkpoint

# 用于业务数据（消息日志、订单审计等）
BUSINESS_MYSQL_URI=mysql+aiomysql://otc_agent:password@localhost:3306/otc_agent_business

# === LLM 配置 ===
# Qwen 兼容 OpenAI API
QWEN_API_BASE=http://internal-llm-gateway.gfsec.local/v1
QWEN_API_KEY=your-internal-api-key
QWEN_MODEL_STANDARD=internal-qwen3-30b-a3b
QWEN_MODEL_THINKING=internal-qwen3-30b-a3b-think
QWEN_MODEL_VL=external-qwen3-vl-235b-a22b-instruct

# Claude API（备选 / LLM-as-Judge 评估）
ANTHROPIC_API_KEY=your-anthropic-key

# === 后端业务接口 ===
OTC_API_BASE_URL=http://otc-backend.gfsec.local
OTC_API_SECRET=your-backend-auth-secret

# === 外部搜索工具（标的识别用）===
BOCHA_API_KEY=your-bocha-key
TAVILY_API_KEY=your-tavily-key

# === goats 标的数据库 ===
GOATS_BASE_URL=http://goats.gfsec.local
GOATS_CLIENT_ID=your-client-id
GOATS_CLIENT_SECRET=your-client-secret
GOATS_EXTAPP_SALT=your-salt

# === 可观测性 ===
LOG_LEVEL=INFO
ENVIRONMENT=development                 # development / staging / production
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=otc-agent

# === 灰度切换 ===
USE_LANGGRAPH=true                      # 逐步切换主链路
LANGGRAPH_TRAFFIC_RATIO=1.0             # 0.0~1.0 灰度流量比例
SHADOW_MODE=false                       # 是否开启双跑对比
