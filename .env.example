# === MySQL：与 Java 共库，复制后填入实际连接账号 ===
# 启动前在目标库执行 sql/init.sql；SQL 不创建库、不包含 USE 或授权。
# 只配置 MYSQL_URI，选择现有 Java 数据库。密码中的特殊字符使用 URL 编码。
# LangGraph 表前缀为 langgraph_，字符集 utf8mb4，排序规则 utf8mb4_general_ci。
# MySQL 版本要求：8.0.19 ≤ v < 9.6.0。
# 本地直启连接 localhost；Docker 内连接宿主机改用 host.docker.internal。
MYSQL_URI=mysql+aiomysql://your-db-user:your-db-password@localhost:3308/otc_goats_ai_trading_dev

# Checkpoint 连接池大小；所有持久化功能均从 MYSQL_URI 读取连接配置。
CHECKPOINT_POOL_MINSIZE=1
CHECKPOINT_POOL_MAXSIZE=10
CHECKPOINT_POOL_RECYCLE_SECONDS=1800
# 多轮会话与请求幂等；启动前在目标库执行 sql/init.sql。
# 纯单元测试可通过命令级环境变量将以下两个开关设置为 false。
USE_MYSQL_CHECKPOINTER=true
REQUEST_IDEMPOTENCY=true
HISTORY_WINDOW_MESSAGES=40

# === LLM 配置 ===
# Qwen 兼容 OpenAI API（阿里云 DashScope）
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_STANDARD=qwen-plus
QWEN_MODEL_THINKING=qwen-max
# 显式配置复杂提取模型，避免切换网关后回落到不支持的默认模型。
QWEN_MODEL_COMPLEX=qwen-max
QWEN_MODEL_VL=qwen-vl-max-latest

# Claude API（备选 / LLM-as-Judge 评估）
ANTHROPIC_API_KEY=your-anthropic-key

# === 后端业务接口 ===
# 基础 URL 不含 /admin-api，客户端自动追加；本地 48080 转发至 48081。
OTC_API_BASE_URL=http://127.0.0.1:48080
OTC_API_SECRET=your-backend-auth-secret

# === 调用预算与只读重试 ===
# 所有步骤共用工作流总预算，并预留收尾时间；后端实际等待受剩余预算限制。
LLM_TIMEOUT_SECONDS=20
# 文本结构化输出预算；视觉转写单独配置，避免截断整张图片。
LLM_OUTPUT_MAX_TOKENS=800
LLM_VISION_MAX_TOKENS=4096
BACKEND_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=60
RESPONSE_RESERVE_SECONDS=5
PERSIST_TIMEOUT_SECONDS=5
MULTIMODAL_FETCH_TIMEOUT_SECONDS=5
GOATS_AGENT_RFQ_TIMEOUT_SECONDS=5
GOATS_AGENT_INSTRUCTION_TIMEOUT_SECONDS=5
GOATS_RFQ_DIRECT_TIMEOUT_SECONDS=5
# 只读节点最多尝试两次；业务写入不自动重试。
NODE_RETRY_MAX_ATTEMPTS=2
NODE_RETRY_INITIAL_INTERVAL_SECONDS=0.5

# === 外部搜索工具（标的识别用）===
BOCHA_API_KEY=your-bocha-key
TAVILY_API_KEY=your-tavily-key

# === GOATS 标的数据库 ===
GOATS_BASE_URL=http://your-goats-host
GOATS_CLIENT_ID=your-client-id
GOATS_CLIENT_SECRET=your-client-secret
GOATS_EXTAPP_SALT=your-salt
# 快速询价所需的 GOATS Agent 标识。
GOATS_OPT_AGENT_ID=
GOATS_OPT_AGENT_SUB_ID=

# === Securities-instrument 标的查询 ===
SECURITIES_INSTRUMENT_URL=http://127.0.0.1:48080/admin-api/integration/securities-instrument/select

# --- 本地 mock_api 模式（uvicorn mock_api.server:app --port 8099；详见 mock_api/README.md）---
# OTC_API_BASE_URL=http://127.0.0.1:8099
# GOATS_BASE_URL=http://127.0.0.1:8099
# SECURITIES_INSTRUMENT_URL=http://127.0.0.1:8099/admin-api/integration/securities-instrument/select

SECURITIES_INSTRUMENT_KEY=your-securities-key

# === 标的池辅助脚本配置（预留；主链路经 Java/GOATS 校验）===
TICKER_MYSQL_HOST=your-ticker-mysql-host
TICKER_MYSQL_PORT=3306
TICKER_MYSQL_USER=your-ticker-mysql-user
TICKER_MYSQL_PASSWORD=your-ticker-mysql-password
TICKER_MYSQL_DB=your-ticker-mysql-db

# === 可观测性 ===
LOG_LEVEL=INFO
# 日志格式：auto（development 彩色控制台，其余 JSON）/ json / console；每条带 trace_id
LOG_FORMAT=auto
ENVIRONMENT=development
ENABLE_LANGFUSE=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=otc-agent
TRUST_INBOUND_TRACEPARENT=false
USE_LANGFUSE_PROMPTS=false

# === 灰度切换 ===
USE_LANGGRAPH=true
LANGGRAPH_TRAFFIC_RATIO=1.0
SHADOW_MODE=false

# 正常联调使用真实后端；仅影子双跑等明确场景设置为 true。
DRY_RUN_BACKEND=false

# === 本地回归隔离上下文（运行 local_eval 前填写授权测试账号） ===
EVAL_USER_ID=
EVAL_ROOM_ID=
EVAL_GUID=
# 测试消息写入 MYSQL_URI 选定的 Java 数据库。
