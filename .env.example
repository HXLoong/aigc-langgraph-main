# === MySQL 配置 ===
# 用于 LangGraph checkpoint（会话状态）
CHECKPOINT_MYSQL_URI=mysql+aiomysql://otc_agent:password@localhost:3306/otc_agent_checkpoint

# 用于业务数据（消息日志、订单审计等）
BUSINESS_MYSQL_URI=mysql+aiomysql://otc_agent:password@localhost:3306/otc_agent_business

# === LLM 配置 ===
# Qwen 兼容 OpenAI API（阿里云 DashScope）
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_STANDARD=qwen-plus
QWEN_MODEL_THINKING=qwen-max
QWEN_MODEL_VL=qwen-vl-max-latest

# Claude API（备选 / LLM-as-Judge 评估）
ANTHROPIC_API_KEY=your-anthropic-key

# === 后端业务接口 ===
OTC_API_BASE_URL=http://your-backend-host/admin-api
OTC_API_SECRET=your-backend-auth-secret

# === 外部搜索工具（标的识别用）===
BOCHA_API_KEY=your-bocha-key
TAVILY_API_KEY=your-tavily-key

# === GOATS 标的数据库 ===
GOATS_BASE_URL=http://your-goats-host
GOATS_CLIENT_ID=your-client-id
GOATS_CLIENT_SECRET=your-client-secret
GOATS_EXTAPP_SALT=your-salt

# === Securities-instrument 标的查询 ===
SECURITIES_INSTRUMENT_URL=http://your-backend-host/admin-api/integration/securities-instrument/select
SECURITIES_INSTRUMENT_KEY=your-securities-key

# === 可观测性 ===
LOG_LEVEL=INFO
ENVIRONMENT=development
ENABLE_LANGFUSE=false

# === 灰度切换 ===
USE_LANGGRAPH=true
LANGGRAPH_TRAFFIC_RATIO=1.0
SHADOW_MODE=false
