# === MySQL：与 Java 共库，复制后填入实际连接账号 ===
# 启动前在目标库执行 sql/init.sql；SQL 不创建库、不包含 USE 或授权。
# 只配置 MYSQL_URI，选择现有 Java 数据库。密码中的特殊字符使用 URL 编码。
# LangGraph 表前缀为 langgraph_，字符集 utf8mb4，排序规则 utf8mb4_general_ci。
# MySQL 版本要求：8.0.19 ≤ v < 9.6.0。
# 本地直启连接 localhost；Docker 内连接宿主机改用 host.docker.internal。
MYSQL_URI=mysql+aiomysql://your-db-user:your-db-password@localhost:3308/otc_goats_ai_trading_dev

# Checkpoint 连接池大小；所有持久化功能均从 MYSQL_URI 读取连接配置。
CHECKPOINT_POOL_MINSIZE=1
CHECKPOINT_POOL_MAXSIZE=10
CHECKPOINT_POOL_RECYCLE_SECONDS=1800
# 多轮会话与节点审计；启动前在目标库执行 sql/init.sql。
# 纯单元测试可通过命令级环境变量将以下两个开关设置为 false。
USE_MYSQL_CHECKPOINTER=true
HISTORY_WINDOW_MESSAGES=40
# 会话闲置超时后清除历史交易上下文，并提示重新发送指令。
CONVERSATION_IDLE_TIMEOUT_SECONDS=1800

# === LLM 配置 ===
# ADR 0020：变量不绑定厂商；当前基线为 deepseek-v4-pro，名称可用网关别名。
# provider 必填：deepseek / qwen / openai_compatible；按接口协议选择，不根据模型名推断。
# 三个模型角色共享连接；切换配置后重启，更换业务模型需重新验收。
LLM_PROVIDER=deepseek
LLM_API_BASE=https://your-openai-compatible-gateway/v1
LLM_API_KEY=your-llm-api-key
# 内网模型网关设 false，绕过系统/环境代理；由应用直接读取，无需 --env-file。
# false 同时忽略 HTTPX 环境证书配置，TLS 证书校验仍开启。
LLM_TRUST_ENV=true
# 业务联合解析器使用 STANDARD；structured 工厂也复用它。
LLM_MODEL_STANDARD=deepseek-v4-pro
# THINKING 供离线改写生成使用，角色名称不自动开启思考。
LLM_MODEL_THINKING=deepseek-v4-pro
# COMPLEX 保留独立配置，当前业务链不使用。
LLM_MODEL_COMPLEX=deepseek-v4-pro
# 本阶段只处理文本与 Excel，图片不进入模型。

# === 后端业务接口 ===
# 基础 URL 不含 /admin-api，客户端自动追加；本地 48080 转发至 48081。
OTC_API_BASE_URL=http://127.0.0.1:48080
OTC_API_SECRET=your-backend-auth-secret

# === 调用预算与只读重试 ===
# 所有步骤共用工作流总预算，并预留收尾时间；后端实际等待受剩余预算限制。
LLM_TIMEOUT_SECONDS=20
# 联合解析的单次输入/输出容量；超限整体拒绝，不分批请求模型。
LLM_OUTPUT_MAX_TOKENS=8192
LLM_INPUT_MAX_BYTES=65536
BACKEND_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=60
RESPONSE_RESERVE_SECONDS=5
PERSIST_TIMEOUT_SECONDS=5
MULTIMODAL_FETCH_TIMEOUT_SECONDS=5
GOATS_AGENT_RFQ_TIMEOUT_SECONDS=5
GOATS_AGENT_INSTRUCTION_TIMEOUT_SECONDS=5
# 后端只读查询最多尝试两次；模型与业务写入均不自动重试。
NODE_RETRY_MAX_ATTEMPTS=2
NODE_RETRY_INITIAL_INTERVAL_SECONDS=0.5

# === GOATS 标的数据库 ===
GOATS_BASE_URL=http://your-goats-host
GOATS_CLIENT_ID=your-client-id
GOATS_CLIENT_SECRET=your-client-secret
GOATS_EXTAPP_SALT=your-salt
# 快速询价所需的 GOATS Agent 标识。
GOATS_OPT_AGENT_ID=
GOATS_OPT_AGENT_SUB_ID=
# 互换 / 通用 GOATS Agent 标识（仅 scripts/probe_goats 探针使用）。
GOATS_COM_AGENT_ID=
GOATS_COM_AGENT_SUB_ID=

# --- 本地 mock_api 模式（uvicorn mock_api.server:app --port 8099；详见 mock_api/README.md）---
# OTC_API_BASE_URL=http://127.0.0.1:8099
# GOATS_BASE_URL=http://127.0.0.1:8099

# 标的识别已移交 Java 后端（ADR 0025）：本地不再有 SECURITIES_INSTRUMENT_* / TICKER_MYSQL_* 配置。

# === 可观测性 ===
LOG_LEVEL=INFO
# 日志格式：auto（development 彩色控制台，其余 JSON）/ json / console；每条带 trace_id
LOG_FORMAT=auto
# Langfuse 和结构化日志字段脱敏；所有环境默认关闭，修改后重启服务。
TELEMETRY_MASKING_ENABLED=false
# 逗号分隔，只隐藏列出的字段；空值不隐藏。字段名忽略大小写、下划线和连字符。
# 支持嵌套对象/列表；不扫描自由文本、不解析字符串内 JSON。
# 需要隐藏原文/提示词/字段记录时，按需追加 raw_text,quote_content,content,evidence,value。
TELEMETRY_MASKING_FIELDS=password,secret,api_key,token,authorization
ENVIRONMENT=development
ENABLE_LANGFUSE=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=otc-agent
TRUST_INBOUND_TRACEPARENT=false
USE_LANGFUSE_PROMPTS=false

# === Langfuse Remote Experiment webhook（POST /v1/webhooks/langfuse）===
# 在 Langfuse Dataset 页面点 Run 时回调本机拉起一次数据集实验。
# 密钥在 Langfuse「Start Experiment → ⚡ → Advanced Options」生成，形如 lf-whsec_<64 hex>。
ENABLE_LANGFUSE_WEBHOOK=false
LANGFUSE_WEBHOOK_SECRET=

# === 影子对照 ===

# 正常联调使用真实后端；仅影子双跑等明确场景设置为 true。
DRY_RUN_BACKEND=false

# === 本地回归隔离上下文（运行 local_eval 前填写授权测试账号） ===
EVAL_USER_ID=
EVAL_ROOM_ID=
EVAL_GUID=
# 测试消息写入 MYSQL_URI 选定的 Java 数据库。

# Langfuse 批量导出使用独立时限，不改变模型调用次数。
LANGFUSE_TIMEOUT_SECONDS=15
LANGFUSE_FLUSH_AT=32
