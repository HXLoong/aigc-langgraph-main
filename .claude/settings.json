{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,

  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",

      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(uv:*)",

      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",

      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose restart:*)",

      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(tree:*)",

      "Bash(uvicorn:*)",
      "Bash(alembic:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(pip uninstall:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(curl *| sh)",
      "Bash(curl *| bash)",
      "Bash(docker compose down -v)"
    ]
  },

  "claudeMdExcludes": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/.pytest_cache/**"
  ],

  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTEST_ADDOPTS": "--color=yes"
  }
}
