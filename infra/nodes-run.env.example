# 节点接口本地验收覆盖配置：复制为根目录 .env.nodes.local，不覆盖 .env。
# 真实 LLM 的 QWEN_API_BASE / QWEN_API_KEY / QWEN_MODEL_* 从现有 .env 读取。
# 如独立部署，在 .env.nodes.local 中填写这些 LLM 变量。不要提交真实凭据。
ENVIRONMENT=staging
OTC_API_BASE_URL=http://127.0.0.1:8099
OTC_API_SECRET=local-mock-token
GOATS_BASE_URL=http://127.0.0.1:8099
GOATS_CLIENT_ID=local-mock-client
GOATS_CLIENT_SECRET=local-mock-secret
GOATS_EXTAPP_SALT=local-mock-salt
GOATS_OPT_AGENT_ID=local-option-agent
GOATS_OPT_AGENT_SUB_ID=local-option-subagent
DRY_RUN_BACKEND=false
ENABLE_LANGFUSE=false
USE_LANGFUSE_PROMPTS=false
REQUEST_IDEMPOTENCY=false
# 以下仅为 docker-compose.yml 的本地开发账号；端口按本机容器映射调整。
BUSINESS_MYSQL_URI=mysql+aiomysql://otc_agent:password@127.0.0.1:3306/otc_agent_business
CHECKPOINT_MYSQL_URI=mysql://otc_agent:password@127.0.0.1:3306/otc_agent_checkpoint
USE_MYSQL_CHECKPOINTER=true
# 主工作流仍使用本地 checkpoint；/v1/nodes/run 永远不挂 checkpointer。
