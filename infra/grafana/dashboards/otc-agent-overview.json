    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "4 个上游（mysql / langfuse / llm / java_backend）的探测结果按 status 分组（1h 内 fail / ok / disabled 次数）。fail 列任一 > 0 → 红色。",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "align": "center",
            "cellOptions": {"type": "color-background"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "fail"},
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "red", "value": 1}
                  ]
                }
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "disabled"},
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "blue", "value": null}
                  ]
                }
              }
            ]
          }
        ]
