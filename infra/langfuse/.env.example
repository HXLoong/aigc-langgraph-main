# LangFuse self-hosted env (ADR 0014 D1/D8)
# 本文件配置 Langfuse 自身的 PostgreSQL/ClickHouse/Redis。
# LangGraph 与 Java 共用 MySQL 的配置位于仓库根目录 .env 及其模板。
#
# 使用方式：
#   cp infra/langfuse/.env.example infra/langfuse/.env
#   # 然后按下方指引填充 SALT / ENCRYPTION_KEY / NEXTAUTH_SECRET 等

# ====================  必填密钥（首次启动前必须生成）====================

# 32 字节随机 base64
# 生成：openssl rand -base64 32
SALT=

# 32 字节 hex（64 字符）
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# 32 字节随机 base64（NextAuth 用）
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET=

# ====================  端口（默认即可）====================
LANGFUSE_PORT=3000
WORKER_PORT=3030
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091
REDIS_PORT=6379

# ====================  数据库 ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# ====================  对象存储（MinIO）====================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# ====================  Redis ====================
REDIS_AUTH=myredissecret

# ====================  NextAuth ====================
NEXTAUTH_URL=http://localhost:3000

# ====================  遥测 ====================
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ====================  首次启动自动化创建（可选） ====================
# 如填写以下变量，LangFuse Web 第一次启动时会自动创建 org/project/user/api-key
# 否则要手动通过浏览器 UI 注册
LANGFUSE_INIT_ORG_ID=otc-agent
LANGFUSE_INIT_ORG_NAME=otc-agent
LANGFUSE_INIT_PROJECT_ID=otc-agent-dev
LANGFUSE_INIT_PROJECT_NAME=otc-agent-dev
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
